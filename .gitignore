# dbt
target/
dbt_packages/
logs/
.user.yml
package-lock.yml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
# Local agent/CLI working files. Plans and scratch notes are not project content.
.snowflake/
# Scratch notes and generated reports written to the repo root. This project tracks no
# HTML of its own, and such files routinely carry account identifiers, so a blanket
# ignore stops `git add -A` sweeping one into a public commit.
/*.html

# Never commit credentials
*.p8
*.pem
.env

# -------------------------------------------------------------------------------------
# Terraform
# -------------------------------------------------------------------------------------
# .terraform/ holds downloaded provider binaries — hundreds of megabytes, and rebuildable
# with `terraform init`.
.terraform/
# State records what Terraform believes exists. It can contain object metadata and, for
# some resources, secret values. Never commit it.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
# Holds your GitHub org name. No secrets, but this repo is meant to be shareable.
terraform.tfvars
*.auto.tfvars
# Saved plans can embed variable values.
*.tfplan
# NOT ignored, deliberately: .terraform.lock.hcl. Committing the lock file is what makes a
# plan reproducible across machines — it pins provider versions and checksums. Ignoring it
# is a common mistake that lets two people resolve different provider versions.

# Performance gate output. Uploaded as a CI artifact, never committed: it is a point-in-time
# measurement of production, not source.
.perf-gate-out/
